# Auth: either set ANTHROPIC_API_KEY, or leave it empty and log in with the
# Claude Code CLI (`claude` / `claude setup-token`) — the SDK reuses that session.
ANTHROPIC_API_KEY=

# Model used by the deep-dive verify agent.
PRS_MODEL=claude-sonnet-5
# Cheaper model for the non-agentic phases (claims, description drafting).
PRS_CLAIMS_MODEL=claude-haiku-4-5-20251001

# Where per-phase results are written.
PRS_SESSION_ROOT=sessions

# Optional: one-way Slack notification when a review finishes.
SLACK_WEBHOOK_URL=
